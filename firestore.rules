rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*davidzisu.*') ||
          request.auth.token.email.matches('.*dzisu.*')
        ))
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Users collection
    match /users/{userId} {
      // Authenticated users can read profiles to see usernames
      allow read: if isAuthenticated();
      
      // User can create their own profile or admin can create
      allow create: if isOwner(userId) || isAdmin();
      
      // Admin can update anything. A user can update their own profile but CANNOT elevate role.
      allow update: if isAdmin() || (
        isOwner(userId) && request.resource.data.role == resource.data.role
      );
      
      // Only admin can delete users
      allow delete: if isAdmin();
    }

    // Agents collection
    match /agents/{agentId} {
      // Authenticated users can view agents
      allow read: if isAuthenticated();
      
      // Only admin can create, update, or delete agents
      allow write: if isAdmin();
    }

    // Chat sessions collection
    match /chat_sessions/{sessionId} {
      // Create only allowed if ownerUid matches the authenticated user's UID
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid;
      
      // Read, update, delete only allowed to session owner or admin
      allow read, update, delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || isAdmin()
      );
    }
  }
}
